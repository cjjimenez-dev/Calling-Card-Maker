<Window x:Class="Calling_Card_Generator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Calling_Card_Generator.Controls"
        mc:Ignorable="d"
        Title="Calling Card Studio" 
        Icon="Assets/app_icon.ico"
        WindowState="Maximized"
        Width="1200" Height="720"
        MinWidth="880" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, sans-serif"
        Background="#FAFAFA"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Emil Kowalski Design Tokens: Crisp Neutrals & Subtlety -->
        <SolidColorBrush x:Key="Zinc950" Color="#09090B"/>
        <SolidColorBrush x:Key="Zinc900" Color="#18181B"/>
        <SolidColorBrush x:Key="Zinc800" Color="#27272A"/>
        <SolidColorBrush x:Key="Zinc700" Color="#3F3F46"/>
        <SolidColorBrush x:Key="Zinc600" Color="#52525B"/>
        <SolidColorBrush x:Key="Zinc500" Color="#71717A"/>
        <SolidColorBrush x:Key="Zinc400" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="Zinc300" Color="#D4D4D8"/>
        <SolidColorBrush x:Key="Zinc200" Color="#E4E4E7"/>
        <SolidColorBrush x:Key="Zinc100" Color="#F4F4F5"/>
        <SolidColorBrush x:Key="Zinc50"  Color="#FAFAFA"/>
        <SolidColorBrush x:Key="BrandBlue" Color="#2563EB"/>
        <SolidColorBrush x:Key="BrandBlueHover" Color="#1D4ED8"/>

        <!-- Modern Clean TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#09090B"/>
            <Setter Property="BorderBrush" Value="#E4E4E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" 
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Padding="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#A1A1AA"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#09090B"/>
            <Setter Property="BorderBrush" Value="#E4E4E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- Clean Secondary Action Button -->
        <Style x:Key="CleanButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="BorderBrush" Value="#E4E4E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#F4F4F5"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#D4D4D8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E4E4E7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Primary Action Button -->
        <Style x:Key="CleanPrimaryButton" TargetType="Button" BasedOn="{StaticResource CleanButton}">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Dark Accent Button -->
        <Style x:Key="CleanDarkButton" TargetType="Button" BasedOn="{StaticResource CleanButton}">
            <Setter Property="Background" Value="#18181B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#18181B"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#27272A"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#27272A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Tool Tile Button -->
        <Style x:Key="ToolTileButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#18181B"/>
            <Setter Property="BorderBrush" Value="#E4E4E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CBD5E1"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Sleek Top Header (44px) -->
            <RowDefinition Height="44"/>
            <!-- Main Responsive Workspace -->
            <RowDefinition Height="*"/>
            <!-- Subdued Status Bar (24px) -->
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- TOP APP HEADER (EMIL / LINEAR STYLE) -->
        <Border Grid.Row="0" Background="#090D1A" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="14,0" SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo Badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2563EB" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="📇" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Calling Card Studio" Foreground="#F8FAFC" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#1E293B" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0" Foreground="#94A3B8" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <!-- Centered Mode Switcher Pill -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#161F30" BorderBrush="#253248" BorderThickness="1" CornerRadius="7" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabDesignerBtn" 
                                         Content="✏️ Designer" 
                                         IsChecked="True" 
                                         GroupName="ModeGroup"
                                         Click="TabDesigner_Click"
                                         Foreground="White" FontWeight="SemiBold" FontSize="11.5"
                                         Padding="14,4" Margin="0,0,2,0" Cursor="Hand"/>
                            <RadioButton x:Name="TabPrintQueueBtn" 
                                         Content="🖨️ Print Queue &amp; Imposition" 
                                         IsChecked="False" 
                                         GroupName="ModeGroup"
                                         Click="TabPrintQueue_Click"
                                         Foreground="#94A3B8" FontWeight="SemiBold" FontSize="11.5"
                                         Padding="14,4" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Top Quick Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💾 Save" Style="{StaticResource CleanDarkButton}" Padding="10,4" Margin="0,0,6,0" Click="BtnSaveTemplate_Click"/>
                    <Button Content="🖼️ Export" Style="{StaticResource CleanDarkButton}" Padding="10,4" Margin="0,0,8,0" Click="BtnExportImage_Click"/>
                    <Button Content="➕ Add to Queue" Style="{StaticResource CleanPrimaryButton}" Padding="12,4" Click="BtnAddToQueue_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN RESPONSIVE CONTENT AREA -->
        <Grid Grid.Row="1">
            <!-- VIEW 1: TEMPLATE DESIGNER -->
            <Grid x:Name="DesignerContainer" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <!-- Left Sidebar (Toolbox) -->
                    <ColumnDefinition Width="260" MinWidth="220" MaxWidth="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Center Canvas -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Right Sidebar (Properties) -->
                    <ColumnDefinition Width="280" MinWidth="240" MaxWidth="360"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E4E4E7" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,12">
                            <!-- Template Preset Dropdown -->
                            <TextBlock Text="PRESETS" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CmbPresets" SelectionChanged="CmbPresets_SelectionChanged" Margin="0,0,0,8" Height="28">
                                <ComboBoxItem Content="Vantage Consulting (Landscape)" IsSelected="True"/>
                                <ComboBoxItem Content="Blank Canvas (Landscape 3.5×2.0&quot;)"/>
                                <ComboBoxItem Content="Blank Canvas (Portrait 2.0×3.5&quot;)"/>
                            </ComboBox>

                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <Button Content="📂 Open..." Style="{StaticResource CleanButton}" Margin="0,0,3,0" Click="BtnOpenTemplate_Click"/>
                                <Button Content="💾 Save As..." Style="{StaticResource CleanButton}" Margin="3,0,0,0" Click="BtnSaveTemplateAs_Click"/>
                            </UniformGrid>

                            <Border Height="1" Background="#F4F4F5" Margin="0,0,0,10"/>

                            <!-- Card Name & Orientation -->
                            <TextBlock Text="CARD SETTINGS" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,6"/>
                            <TextBox x:Name="TxtCardName" Height="26" Margin="0,0,0,8" TextChanged="TxtCardName_TextChanged"/>

                            <!-- Orientation Toggle Pill -->
                            <Border Background="#F4F4F5" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,0,12">
                                <UniformGrid Columns="2">
                                    <RadioButton x:Name="RbPortrait" Content="Portrait (2×3.5&quot;)" IsChecked="True" Click="RbOrientation_Click" 
                                                 FontSize="11" FontWeight="SemiBold" Padding="4,3" HorizontalAlignment="Center"/>
                                    <RadioButton x:Name="RbLandscape" Content="Landscape (3.5×2&quot;)" Click="RbOrientation_Click" 
                                                 FontSize="11" FontWeight="SemiBold" Padding="4,3" HorizontalAlignment="Center"/>
                                </UniformGrid>
                            </Border>

                            <Border Height="1" Background="#F4F4F5" Margin="0,0,0,10"/>

                            <!-- Front / Back Side Switcher -->
                            <TextBlock Text="EDITING SIDE" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,6"/>
                            <Border Background="#F4F4F5" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="2" Margin="0,0,0,14">
                                <UniformGrid Columns="2">
                                    <Button x:Name="BtnSideFront" Content="📄 Front Side" Style="{StaticResource CleanPrimaryButton}" Margin="1" Click="BtnSideFront_Click"/>
                                    <Button x:Name="BtnSideBack" Content="📄 Back Side" Style="{StaticResource CleanButton}" Margin="1" Click="BtnSideBack_Click"/>
                                </UniformGrid>
                            </Border>

                            <Border Height="1" Background="#F4F4F5" Margin="0,0,0,10"/>

                            <!-- Add Elements 2x2 Grid + QR Code -->
                            <TextBlock Text="ADD ELEMENTS" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,6"/>
                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                <Button Style="{StaticResource ToolTileButton}" Margin="0,0,3,6" Click="BtnAddText_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔤" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Text" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolTileButton}" Margin="3,0,0,6" Click="BtnAddImage_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖼️" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Image/Logo" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolTileButton}" Margin="0,0,3,0" Click="BtnAddLine_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➖" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Line" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ToolTileButton}" Margin="3,0,0,0" Click="BtnAddRectangle_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⬛" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Box" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <Button Style="{StaticResource ToolTileButton}" Margin="0,0,0,12" Click="BtnAddQrCode_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📱" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="QR Code (URL / vCard)" FontSize="11.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>

                            <Border Height="1" Background="#F4F4F5" Margin="0,0,0,10"/>

                            <!-- Background Settings -->
                            <TextBlock Text="BACKGROUND" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,6"/>
                            <WrapPanel Margin="0,0,0,6">
                                <Button Width="22" Height="22" Background="#FFFFFF" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#FFFFFF" ToolTip="White"/>
                                <Button Width="22" Height="22" Background="#0B1D4B" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#0B1D4B" ToolTip="Vantage Navy"/>
                                <Button Width="22" Height="22" Background="#0F265C" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#0F265C" ToolTip="Deep Navy"/>
                                <Button Width="22" Height="22" Background="#18181B" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#18181B" ToolTip="Dark Slate"/>
                                <Button Width="22" Height="22" Background="#2563EB" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#2563EB" ToolTip="Royal Blue"/>
                                <Button Width="22" Height="22" Background="#F4F4F5" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#F4F4F5" ToolTip="Light Gray"/>
                                <Button Width="22" Height="22" Background="#D97706" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#D97706" ToolTip="Amber"/>
                                <Button Width="22" Height="22" Background="#DC2626" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#DC2626" ToolTip="Crimson Red"/>
                                <Button Width="22" Height="22" Background="#059669" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#059669" ToolTip="Emerald Green"/>
                                <Button Width="22" Height="22" Background="#7C3AED" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#7C3AED" ToolTip="Purple"/>
                            </WrapPanel>
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <Border Width="22" Height="22" Background="#FFFFFF" BorderBrush="#D4D4D8" BorderThickness="1" CornerRadius="3" Margin="0,0,5,0" DockPanel.Dock="Left">
                                    <Border x:Name="RectLeftBgPreview" Background="#FFFFFF" CornerRadius="2"/>
                                </Border>
                                <TextBlock Text="Hex: " VerticalAlignment="Center" FontSize="11" Foreground="#71717A" Margin="0,0,4,0" DockPanel.Dock="Left"/>
                                <TextBox x:Name="TxtBgHex" Height="24" Text="#FFFFFF" TextChanged="TxtBgHex_TextChanged" LostFocus="TxtBgHex_LostFocus" KeyDown="TxtBgHex_KeyDown"/>
                            </DockPanel>
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <Button Content="🖼️ Image..." Style="{StaticResource CleanButton}" Margin="0,0,3,0" Click="BtnSetBgImage_Click"/>
                                <Button Content="✕ Clear" Style="{StaticResource CleanButton}" Margin="3,0,0,0" Click="BtnClearBgImage_Click"/>
                            </UniformGrid>

                            <Border Height="1" Background="#F4F4F5" Margin="0,0,0,10"/>

                            <!-- View & Guides -->
                            <TextBlock Text="VIEW &amp; GUIDES" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,6"/>
                            <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                <TextBlock Text="Zoom: " VerticalAlignment="Center" FontSize="11" Foreground="#71717A"/>
                                <ComboBox x:Name="CmbZoom" SelectionChanged="CmbZoom_SelectionChanged" Height="24">
                                    <ComboBoxItem Content="75%"/>
                                    <ComboBoxItem Content="100%"/>
                                    <ComboBoxItem Content="125%"/>
                                    <ComboBoxItem Content="150%" IsSelected="True"/>
                                    <ComboBoxItem Content="200%"/>
                                    <ComboBoxItem Content="250%"/>
                                    <ComboBoxItem Content="300%"/>
                                </ComboBox>
                            </DockPanel>
                            <CheckBox x:Name="ChkSafeGuide" Content="Safe Area Margin (Green)" IsChecked="True" Checked="ChkGuide_Changed" Unchecked="ChkGuide_Changed" FontSize="11" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkBleedGuide" Content="Bleed / Cut Line (Red)" IsChecked="True" Checked="ChkGuide_Changed" Unchecked="ChkGuide_Changed" FontSize="11"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Clean Divider Line -->
                <GridSplitter Grid.Column="1" Width="1" Background="#E4E4E7" HorizontalAlignment="Center"/>

                <!-- CENTER: CANVAS WORKSPACE -->
                <Grid Grid.Column="2" Background="#F4F4F5">
                    <Grid.RowDefinitions>
                        <!-- Top Floating Context Bar (34px) -->
                        <RowDefinition Height="34"/>
                        <!-- Interactive Canvas Area -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Top Context Bar -->
                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E4E4E7" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock x:Name="TxtCanvasHeader" Text="Vantage Consulting (Front Side)" FontWeight="SemiBold" FontSize="12" Foreground="#09090B" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtCanvasSizeDesc" Text=" • 3.5&quot; × 2.0&quot; @ 300 DPI" Foreground="#71717A" FontSize="11.5" Margin="4,0,0,0" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="BtnUndo" Content="↩️ Undo" Style="{StaticResource CleanButton}" Padding="7,3" Margin="0,0,4,0" ToolTip="Undo (Ctrl+Z)" Click="BtnUndo_Click"/>
                                <Button x:Name="BtnRedo" Content="↪️ Redo" Style="{StaticResource CleanButton}" Padding="7,3" Margin="0,0,6,0" ToolTip="Redo (Ctrl+Y)" Click="BtnRedo_Click"/>
                                <Border Width="1" Background="#E4E4E7" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <Button x:Name="BtnGroup" Content="🔗 Group" Style="{StaticResource CleanButton}" Padding="7,3" Margin="0,0,4,0" ToolTip="Group selected elements (Ctrl+G). Drag or Ctrl+Click to select multiple." Click="BtnGroup_Click"/>
                                <Button x:Name="BtnUngroup" Content="🔓 Ungroup" Style="{StaticResource CleanButton}" Padding="7,3" Margin="0,0,6,0" ToolTip="Ungroup selected group (Ctrl+Shift+G)" Click="BtnUngroup_Click"/>
                                <Border Width="1" Background="#E4E4E7" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <Button Content="⬆️ To Front" Style="{StaticResource CleanButton}" Padding="7,3" Margin="0,0,4,0" ToolTip="Bring selected element in front of all others" Click="BtnBringToFront_Click"/>
                                <Button Content="⬇️ To Back" Style="{StaticResource CleanButton}" Padding="7,3" Margin="0,0,6,0" ToolTip="Send selected element behind all others" Click="BtnSendToBack_Click"/>
                                <Border Width="1" Background="#E4E4E7" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <Button Content="📋 Duplicate" Style="{StaticResource CleanButton}" Padding="7,3" Margin="0,0,4,0" Click="BtnDuplicateSelected_Click"/>
                                <Button Content="🗑️ Delete" Style="{StaticResource CleanButton}" Padding="7,3" Click="BtnDeleteSelected_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Interactive Card Canvas -->
                    <controls:CardCanvasControl x:Name="CardCanvas" Grid.Row="1"/>
                </Grid>

                <!-- Clean Divider Line -->
                <GridSplitter Grid.Column="3" Width="1" Background="#E4E4E7" HorizontalAlignment="Center"/>

                <!-- RIGHT SIDEBAR: PROPERTIES PANEL -->
                <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#E4E4E7" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="14,12">
                            <!-- Section Title -->
                            <TextBlock Text="PROPERTIES" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,10"/>

                            <!-- Card & Background Properties (Active when no element is selected) -->
                            <StackPanel x:Name="CardPropertiesPanel" Visibility="Visible">
                                <!-- Active Side Indicator & Quick Switch -->
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="EDITING SIDE" FontSize="9" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock x:Name="TxtActiveSideLabel" Text="📄 Front Side" FontSize="12.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="BtnSwitchSideQuick" Grid.Column="1" Content="⇄ Switch" Style="{StaticResource CleanButton}" Padding="8,3" FontSize="10.5" VerticalAlignment="Center" Click="BtnSwitchSideQuick_Click"/>
                                    </Grid>
                                </Border>

                                <!-- Side Background Color -->
                                <TextBlock Text="Side Background Color" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,0,6"/>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button Width="23" Height="23" Background="#FFFFFF" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#FFFFFF" ToolTip="White"/>
                                    <Button Width="23" Height="23" Background="#0B1D4B" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#0B1D4B" ToolTip="Vantage Navy (#0B1D4B)"/>
                                    <Button Width="23" Height="23" Background="#0F265C" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#0F265C" ToolTip="Deep Navy (#0F265C)"/>
                                    <Button Width="23" Height="23" Background="#18181B" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#18181B" ToolTip="Dark Slate (#18181B)"/>
                                    <Button Width="23" Height="23" Background="#2563EB" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#2563EB" ToolTip="Royal Blue (#2563EB)"/>
                                    <Button Width="23" Height="23" Background="#F4F4F5" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#F4F4F5" ToolTip="Light Gray (#F4F4F5)"/>
                                    <Button Width="23" Height="23" Background="#D97706" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#D97706" ToolTip="Amber (#D97706)"/>
                                    <Button Width="23" Height="23" Background="#DC2626" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#DC2626" ToolTip="Crimson Red (#DC2626)"/>
                                    <Button Width="23" Height="23" Background="#059669" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#059669" ToolTip="Emerald Green (#059669)"/>
                                    <Button Width="23" Height="23" Background="#7C3AED" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,4" Click="BtnSetBgColor_Click" Tag="#7C3AED" ToolTip="Purple (#7C3AED)"/>
                                </WrapPanel>

                                <!-- Live Hex Code Input -->
                                <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                    <Border Width="24" Height="24" Background="#FFFFFF" BorderBrush="#D4D4D8" BorderThickness="1" CornerRadius="3" Margin="0,0,6,0" DockPanel.Dock="Left">
                                        <Border x:Name="RectSideBgPreview" Background="#FFFFFF" CornerRadius="2"/>
                                    </Border>
                                    <TextBlock Text="Hex: " VerticalAlignment="Center" FontSize="11" Foreground="#71717A" Margin="0,0,4,0" DockPanel.Dock="Left"/>
                                    <TextBox x:Name="TxtSideBgHex" Height="25" Text="#FFFFFF" TextChanged="TxtSideBgHex_TextChanged" LostFocus="TxtSideBgHex_LostFocus" KeyDown="TxtSideBgHex_KeyDown"/>
                                </DockPanel>

                                <Border Height="1" Background="#F4F4F5" Margin="0,0,0,12"/>

                                <!-- Background Image Option -->
                                <TextBlock Text="Background Image" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,0,6"/>
                                <UniformGrid Columns="2" Margin="0,0,0,14">
                                    <Button Content="🖼️ Image..." Style="{StaticResource CleanButton}" Margin="0,0,3,0" Click="BtnSetBgImage_Click"/>
                                    <Button Content="✕ Clear" Style="{StaticResource CleanButton}" Margin="3,0,0,0" Click="BtnClearBgImage_Click"/>
                                </UniformGrid>

                                <Border Height="1" Background="#F4F4F5" Margin="0,0,0,12"/>

                                <!-- Card Specifications Summary Card -->
                                <TextBlock Text="CARD SPECIFICATIONS" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,6"/>
                                <Border Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Dimensions:" FontSize="10.5" Foreground="#71717A"/>
                                            <TextBlock x:Name="TxtCardOrientDesc" Text="3.5″ × 2.0″ (Landscape)" FontSize="10.5" FontWeight="SemiBold" Foreground="#18181B" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock Text="Print Resolution:" FontSize="10.5" Foreground="#71717A"/>
                                            <TextBlock Text="300 DPI High-Res" FontSize="10.5" FontWeight="SemiBold" Foreground="#18181B" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                        <DockPanel>
                                            <TextBlock Text="Sheet Imposition:" FontSize="10.5" Foreground="#71717A"/>
                                            <TextBlock Text="10-Up Grid on Letter" FontSize="10.5" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="💡 Click any element or drag a box to multi-select and group (Ctrl+G)." TextWrapping="Wrap" Foreground="#94A3B8" FontSize="10.5" Margin="2,12,2,0"/>
                            </StackPanel>

                            <!-- Multi-Selection Properties (Active when 2+ elements are selected) -->
                            <StackPanel x:Name="MultiSelectionPanel" Visibility="Collapsed">
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtMultiSelectCount" Text="2 Elements Selected" FontWeight="Bold" FontSize="12" Foreground="#1E40AF"/>
                                        <TextBlock Text="Drag to move together, align, or group into one unit." TextWrapping="Wrap" FontSize="10.5" Foreground="#3B82F6" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Button Content="🔗 Group Selected (Ctrl+G)" Style="{StaticResource CleanPrimaryButton}" Height="30" Margin="0,0,0,10" Click="BtnGroup_Click"/>

                                <TextBlock Text="ALIGN SELECTION ON CARD" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,6"/>
                                <UniformGrid Columns="3" Margin="0,0,0,4">
                                    <Button Content="Left" Style="{StaticResource CleanButton}" Padding="4,3" Margin="0,0,2,0" Click="BtnAlignCardLeft_Click"/>
                                    <Button Content="Center H" Style="{StaticResource CleanButton}" Padding="4,3" Margin="2,0,2,0" Click="BtnAlignCardCenterH_Click"/>
                                    <Button Content="Right" Style="{StaticResource CleanButton}" Padding="4,3" Margin="2,0,0,0" Click="BtnAlignCardRight_Click"/>
                                </UniformGrid>
                                <UniformGrid Columns="3" Margin="0,0,0,12">
                                    <Button Content="Top" Style="{StaticResource CleanButton}" Padding="4,3" Margin="0,0,2,0" Click="BtnAlignCardTop_Click"/>
                                    <Button Content="Center V" Style="{StaticResource CleanButton}" Padding="4,3" Margin="2,0,2,0" Click="BtnAlignCardCenterV_Click"/>
                                    <Button Content="Bottom" Style="{StaticResource CleanButton}" Padding="4,3" Margin="2,0,0,0" Click="BtnAlignCardBottom_Click"/>
                                </UniformGrid>

                                <UniformGrid Columns="2">
                                    <Button Content="📋 Duplicate" Style="{StaticResource CleanButton}" Padding="6,4" Margin="0,0,3,0" Click="BtnDuplicateSelected_Click"/>
                                    <Button Content="🗑️ Delete All" Style="{StaticResource CleanButton}" Foreground="#DC2626" BorderBrush="#FECACA" Padding="6,4" Margin="3,0,0,0" Click="BtnDeleteSelected_Click"/>
                                </UniformGrid>
                            </StackPanel>

                            <!-- Element Properties Card -->
                            <StackPanel x:Name="ElementPropertiesPanel" Visibility="Collapsed">
                                <!-- Type Badge + Delete -->
                                <DockPanel LastChildFill="False" Margin="0,0,0,10">
                                    <Border Background="#EFF6FF" CornerRadius="4" Padding="6,2">
                                        <TextBlock x:Name="TxtElementTypeHeader" Text="Text Element" FontWeight="SemiBold" FontSize="11.5" Foreground="#2563EB"/>
                                    </Border>
                                    <Button DockPanel.Dock="Right" Content="Delete" Style="{StaticResource CleanButton}" Foreground="#DC2626" BorderBrush="#FECACA" Padding="6,2" Click="BtnDeleteSelected_Click"/>
                                </DockPanel>

                                <!-- GROUP PROPERTIES -->
                                <StackPanel x:Name="GroupPropertiesGroup" Visibility="Collapsed" Margin="0,0,0,8">
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock x:Name="TxtGroupInfo" Text="Grouped Elements (2 items)" FontWeight="SemiBold" FontSize="11.5" Foreground="#0F172A"/>
                                            <TextBlock Text="Move, resize, align, or layer all grouped items together. Ungroup anytime to edit individual text boxes." TextWrapping="Wrap" FontSize="10.5" Foreground="#64748B" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="🔓 Ungroup (Ctrl+Shift+G)" Style="{StaticResource CleanButton}" Height="28" Click="BtnUngroup_Click"/>
                                </StackPanel>

                                <!-- TEXT PROPERTIES -->
                                <StackPanel x:Name="TextPropertiesGroup" Visibility="Visible">
                                    <TextBlock Text="Content" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtElementContent" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,0,0,8" TextChanged="TxtElementContent_TextChanged"/>

                                    <TextBlock Text="Font Family" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbFontFamily" SelectionChanged="CmbFontFamily_SelectionChanged" Height="26" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Arial" IsSelected="True"/>
                                        <ComboBoxItem Content="Segoe UI"/>
                                        <ComboBoxItem Content="Calibri"/>
                                        <ComboBoxItem Content="Times New Roman"/>
                                        <ComboBoxItem Content="Georgia"/>
                                        <ComboBoxItem Content="Tahoma"/>
                                        <ComboBoxItem Content="Trebuchet MS"/>
                                        <ComboBoxItem Content="Impact"/>
                                        <ComboBoxItem Content="Consolas"/>
                                    </ComboBox>

                                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                        <TextBlock Text="Size (pt)" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtFontSize" Width="40" Height="24" DockPanel.Dock="Right" Text="12" LostFocus="TxtFontSize_LostFocus" KeyDown="TxtFontSize_KeyDown"/>
                                        <Slider x:Name="SliderFontSize" Minimum="5" Maximum="40" Value="12" ValueChanged="SliderFontSize_ValueChanged" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <!-- Style & Align Toggles -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#F4F4F5" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="5" Padding="2" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnBold" Content="B" Width="28" Height="26" Padding="0" FontWeight="Bold" FontSize="12" Style="{StaticResource CleanButton}" BorderThickness="0" Margin="0,0,1,0" ToolTip="Bold" Click="BtnBold_Click"/>
                                                <Button x:Name="BtnItalic" Content="I" Width="28" Height="26" Padding="0" FontStyle="Italic" FontSize="12" Style="{StaticResource CleanButton}" BorderThickness="0" Margin="0,0,1,0" ToolTip="Italic" Click="BtnItalic_Click"/>
                                                <Button x:Name="BtnUnderline" Width="28" Height="26" Padding="0" FontSize="12" Style="{StaticResource CleanButton}" BorderThickness="0" ToolTip="Underline" Click="BtnUnderline_Click">
                                                    <TextBlock Text="U" TextDecorations="Underline" FontWeight="SemiBold"/>
                                                </Button>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="1" Background="#F4F4F5" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="5" Padding="2" HorizontalAlignment="Right">
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnAlignLeft" Content="Left" Width="34" Height="26" Padding="0" FontSize="10.5" Style="{StaticResource CleanButton}" BorderThickness="0" Margin="0,0,1,0" ToolTip="Align Text Left" Click="BtnAlignLeft_Click"/>
                                                <Button x:Name="BtnAlignCenter" Content="Ctr" Width="32" Height="26" Padding="0" FontSize="10.5" Style="{StaticResource CleanButton}" BorderThickness="0" Margin="0,0,1,0" ToolTip="Align Text Center" Click="BtnAlignCenter_Click"/>
                                                <Button x:Name="BtnAlignRight" Content="Right" Width="36" Height="26" Padding="0" FontSize="10.5" Style="{StaticResource CleanButton}" BorderThickness="0" ToolTip="Align Text Right" Click="BtnAlignRight_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Text Color Chips -->
                                    <TextBlock Text="Color" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Button Width="20" Height="20" Background="#000000" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetTextColor_Click" Tag="#000000"/>
                                        <Button Width="20" Height="20" Background="#0F265C" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetTextColor_Click" Tag="#0F265C"/>
                                        <Button Width="20" Height="20" Background="#1E3A8A" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetTextColor_Click" Tag="#1E3A8A"/>
                                        <Button Width="20" Height="20" Background="#2563EB" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetTextColor_Click" Tag="#2563EB"/>
                                        <Button Width="20" Height="20" Background="#52525B" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetTextColor_Click" Tag="#52525B"/>
                                        <Button Width="20" Height="20" Background="#DC2626" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetTextColor_Click" Tag="#DC2626"/>
                                        <Button Width="20" Height="20" Background="#D97706" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetTextColor_Click" Tag="#D97706"/>
                                        <Button Width="20" Height="20" Background="#FFFFFF" BorderBrush="#D4D4D8" BorderThickness="1" Click="BtnSetTextColor_Click" Tag="#FFFFFF"/>
                                    </StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                        <TextBlock Text="Hex: " VerticalAlignment="Center" FontSize="11" Foreground="#71717A"/>
                                        <TextBox x:Name="TxtTextColorHex" Width="75" Height="24" LostFocus="TxtTextColorHex_LostFocus" KeyDown="TxtTextColorHex_KeyDown"/>
                                    </DockPanel>
                                </StackPanel>

                                <!-- IMAGE PROPERTIES -->
                                <StackPanel x:Name="ImagePropertiesGroup" Visibility="Collapsed">
                                    <Border BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="5" Height="56" Background="#FAFAFA" Margin="0,0,0,6">
                                        <Image x:Name="ImgPreviewThumbnail" Stretch="Uniform" Margin="3"/>
                                    </Border>
                                    <Button Content="📁 Replace Image..." Style="{StaticResource CleanButton}" Margin="0,0,0,6" Click="BtnReplaceImage_Click"/>

                                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                        <TextBlock Text="Opacity" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,8,0"/>
                                        <Slider x:Name="SliderImageOpacity" Minimum="0.1" Maximum="1.0" Value="1.0" ValueChanged="SliderImageOpacity_ValueChanged" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <TextBlock Text="Stretch Mode" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,0,3"/>
                                    <ComboBox x:Name="CmbImageStretch" SelectionChanged="CmbImageStretch_SelectionChanged" Height="24" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Uniform (Keep Aspect Ratio)" IsSelected="True"/>
                                        <ComboBoxItem Content="UniformToFill (Crop to Fit)"/>
                                        <ComboBoxItem Content="Fill (Stretch to Dimensions)"/>
                                    </ComboBox>

                                    <!-- Image Rotation & Orientation Controls -->
                                    <TextBlock Text="Rotate &amp; Orientation" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,0,4"/>
                                    <UniformGrid Columns="4" Margin="0,0,0,5">
                                        <Button Content="↺ -90°" Style="{StaticResource CleanButton}" Padding="2,3" Margin="0,0,2,0" ToolTip="Rotate 90 degrees Left" Click="BtnRotateCCW_Click"/>
                                        <Button Content="↻ +90°" Style="{StaticResource CleanButton}" Padding="2,3" Margin="2,0,2,0" ToolTip="Rotate 90 degrees Right" Click="BtnRotateCW_Click"/>
                                        <Button Content="🔄 180°" Style="{StaticResource CleanButton}" Padding="2,3" Margin="2,0,2,0" ToolTip="Rotate 180 degrees" Click="BtnRotate180_Click"/>
                                        <Button Content="0°" Style="{StaticResource CleanButton}" Padding="2,3" Margin="2,0,0,0" ToolTip="Reset rotation to 0" Click="BtnRotateReset_Click"/>
                                    </UniformGrid>

                                    <DockPanel LastChildFill="True" Margin="0,0,0,6">
                                        <TextBlock Text="Angle (°)" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,8,0"/>
                                        <TextBox x:Name="TxtRotationAngle" Width="40" Height="22" DockPanel.Dock="Right" Text="0" LostFocus="TxtRotationAngle_LostFocus" KeyDown="TxtRotationAngle_KeyDown"/>
                                        <Slider x:Name="SliderRotationAngle" Minimum="0" Maximum="360" Value="0" ValueChanged="SliderRotationAngle_ValueChanged" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <Button Content="⇄ Flip Horizontal" Style="{StaticResource CleanButton}" Padding="4,3" Margin="0,0,2,0" ToolTip="Flip Image Horizontally" Click="BtnFlipHorizontal_Click"/>
                                        <Button Content="⇅ Flip Vertical" Style="{StaticResource CleanButton}" Padding="4,3" Margin="2,0,0,0" ToolTip="Flip Image Vertically" Click="BtnFlipVertical_Click"/>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- SHAPE PROPERTIES -->
                                <StackPanel x:Name="ShapePropertiesGroup" Visibility="Collapsed">
                                    <TextBlock Text="Fill Color" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,0,4"/>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                        <TextBlock Text="Hex: " VerticalAlignment="Center" FontSize="11" Foreground="#71717A"/>
                                        <TextBox x:Name="TxtShapeFillHex" Width="75" Height="24" LostFocus="TxtShapeFillHex_LostFocus" KeyDown="TxtShapeFillHex_KeyDown"/>
                                    </DockPanel>

                                    <TextBlock Text="Stroke / Border" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,0,4"/>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                        <TextBlock Text="Hex: " VerticalAlignment="Center" FontSize="11" Foreground="#71717A"/>
                                        <TextBox x:Name="TxtShapeStrokeHex" Width="75" Height="24" LostFocus="TxtShapeStrokeHex_LostFocus" KeyDown="TxtShapeStrokeHex_KeyDown"/>
                                    </DockPanel>

                                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                        <TextBlock Text="Border Width" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,8,0"/>
                                        <Slider x:Name="SliderShapeThickness" Minimum="0.5" Maximum="10" Value="1.0" ValueChanged="SliderShapeThickness_ValueChanged" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <DockPanel LastChildFill="True" Margin="0,0,0,10">
                                        <TextBlock Text="Corner Radius" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,8,0"/>
                                        <Slider x:Name="SliderShapeCornerRadius" Minimum="0" Maximum="25" Value="0" ValueChanged="SliderShapeCornerRadius_ValueChanged" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>

                                <!-- QR CODE PROPERTIES -->
                                <StackPanel x:Name="QrPropertiesGroup" Visibility="Collapsed">
                                    <TextBlock Text="Quick Fill Preset" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,0,4"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,8">
                                        <Button Content="🌐 Website URL" Style="{StaticResource CleanButton}" Padding="4,3" Margin="0,0,2,0" Click="BtnQrPresetUrl_Click"/>
                                        <Button Content="👤 vCard (From Card)" Style="{StaticResource CleanButton}" Padding="4,3" Margin="2,0,0,0" Click="BtnQrPresetVCard_Click"/>
                                    </UniformGrid>

                                    <TextBlock Text="QR Content (URL, vCard, or Text)" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtQrContent" AcceptsReturn="True" TextWrapping="Wrap" Height="68" VerticalContentAlignment="Top" Padding="6,4" Margin="0,0,0,8" TextChanged="TxtQrContent_TextChanged"/>

                                    <TextBlock Text="QR Color" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Button Width="20" Height="20" Background="#000000" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetQrDarkColor_Click" Tag="#000000"/>
                                        <Button Width="20" Height="20" Background="#0B1D4B" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetQrDarkColor_Click" Tag="#0B1D4B"/>
                                        <Button Width="20" Height="20" Background="#1E3A8A" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetQrDarkColor_Click" Tag="#1E3A8A"/>
                                        <Button Width="20" Height="20" Background="#2563EB" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetQrDarkColor_Click" Tag="#2563EB"/>
                                        <Button Width="20" Height="20" Background="#18181B" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetQrDarkColor_Click" Tag="#18181B"/>
                                        <Button Width="20" Height="20" Background="#DC2626" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetQrDarkColor_Click" Tag="#DC2626"/>
                                        <Button Width="20" Height="20" Background="#FFFFFF" BorderBrush="#D4D4D8" BorderThickness="1" Click="BtnSetQrDarkColor_Click" Tag="#FFFFFF"/>
                                    </StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                        <TextBlock Text="Hex: " VerticalAlignment="Center" FontSize="11" Foreground="#71717A"/>
                                        <TextBox x:Name="TxtQrDarkHex" Width="80" Height="24" Text="#000000" TextChanged="TxtQrDarkHex_TextChanged"/>
                                    </DockPanel>

                                    <TextBlock Text="QR Background" FontSize="11" FontWeight="SemiBold" Foreground="#3F3F46" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <Button Width="20" Height="20" Background="#FFFFFF" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetQrLightColor_Click" Tag="#FFFFFF" ToolTip="White"/>
                                        <Button Content="∅" Width="20" Height="20" Padding="0" FontSize="11" Style="{StaticResource CleanButton}" Margin="0,0,4,0" Click="BtnSetQrLightColor_Click" Tag="Transparent" ToolTip="Transparent"/>
                                        <Button Width="20" Height="20" Background="#F4F4F5" BorderBrush="#D4D4D8" BorderThickness="1" Margin="0,0,4,0" Click="BtnSetQrLightColor_Click" Tag="#F4F4F5" ToolTip="Light Gray"/>
                                        <Button Width="20" Height="20" Background="#0B1D4B" BorderBrush="#D4D4D8" BorderThickness="1" Click="BtnSetQrLightColor_Click" Tag="#0B1D4B" ToolTip="Vantage Navy"/>
                                    </StackPanel>
                                    <DockPanel LastChildFill="True" Margin="0,0,0,8">
                                        <TextBlock Text="Hex: " VerticalAlignment="Center" FontSize="11" Foreground="#71717A"/>
                                        <TextBox x:Name="TxtQrLightHex" Width="90" Height="24" Text="#FFFFFF" TextChanged="TxtQrLightHex_TextChanged"/>
                                    </DockPanel>
                                </StackPanel>

                                <Border Height="1" Background="#F4F4F5" Margin="0,0,0,10"/>

                                <!-- POSITION & DIMENSIONS -->
                                <TextBlock Text="BOUNDS (PX)" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="X: " VerticalAlignment="Center" FontSize="11" Foreground="#71717A"/>
                                        <TextBox x:Name="TxtElemX" Height="24" LostFocus="TxtElemX_LostFocus" KeyDown="TxtElemX_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Y: " VerticalAlignment="Center" FontSize="11" Foreground="#71717A"/>
                                        <TextBox x:Name="TxtElemY" Height="24" LostFocus="TxtElemY_LostFocus" KeyDown="TxtElemY_KeyDown"/>
                                    </DockPanel>
                                </Grid>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <DockPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="W: " VerticalAlignment="Center" FontSize="11" Foreground="#71717A"/>
                                        <TextBox x:Name="TxtElemWidth" Height="24" LostFocus="TxtElemWidth_LostFocus" KeyDown="TxtElemWidth_KeyDown"/>
                                    </DockPanel>
                                    <DockPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="H: " VerticalAlignment="Center" FontSize="11" Foreground="#71717A"/>
                                        <TextBox x:Name="TxtElemHeight" Height="24" LostFocus="TxtElemHeight_LostFocus" KeyDown="TxtElemHeight_KeyDown"/>
                                    </DockPanel>
                                </Grid>

                                <Border Height="1" Background="#F4F4F5" Margin="0,0,0,10"/>

                                <!-- ALIGN ON CARD -->
                                <TextBlock Text="ALIGNMENT" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,6"/>
                                <UniformGrid Columns="3" Margin="0,0,0,4">
                                    <Button Content="Left" Style="{StaticResource CleanButton}" Padding="4,3" Margin="0,0,2,0" Click="BtnAlignCardLeft_Click"/>
                                    <Button Content="Center H" Style="{StaticResource CleanButton}" Padding="4,3" Margin="2,0,2,0" Click="BtnAlignCardCenterH_Click"/>
                                    <Button Content="Right" Style="{StaticResource CleanButton}" Padding="4,3" Margin="2,0,0,0" Click="BtnAlignCardRight_Click"/>
                                </UniformGrid>
                                <UniformGrid Columns="3" Margin="0,0,0,10">
                                    <Button Content="Top" Style="{StaticResource CleanButton}" Padding="4,3" Margin="0,0,2,0" Click="BtnAlignCardTop_Click"/>
                                    <Button Content="Center V" Style="{StaticResource CleanButton}" Padding="4,3" Margin="2,0,2,0" Click="BtnAlignCardCenterV_Click"/>
                                    <Button Content="Bottom" Style="{StaticResource CleanButton}" Padding="4,3" Margin="2,0,0,0" Click="BtnAlignCardBottom_Click"/>
                                </UniformGrid>

                                <Border Height="1" Background="#F4F4F5" Margin="0,0,0,10"/>

                                <!-- LAYER ORDER (Z-ORDER) -->
                                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                    <TextBlock Text="LAYER ORDER (FRONT / BACK)" FontSize="10" FontWeight="Bold" Foreground="#71717A" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <TextBlock Text="Index: " FontSize="10.5" Foreground="#71717A" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtElemZIndex" Width="38" Height="22" Text="0" TextAlignment="Center" LostFocus="TxtElemZIndex_LostFocus" KeyDown="TxtElemZIndex_KeyDown"/>
                                    </StackPanel>
                                </DockPanel>
                                <UniformGrid Columns="2" Margin="0,0,0,4">
                                    <Button Content="⤒ To Front" Style="{StaticResource CleanButton}" Padding="6,3" Margin="0,0,2,0" ToolTip="Place in front of all elements" Click="BtnBringToFront_Click"/>
                                    <Button Content="⤓ To Back" Style="{StaticResource CleanButton}" Padding="6,3" Margin="2,0,0,0" ToolTip="Place behind all elements" Click="BtnSendToBack_Click"/>
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <Button Content="↑ Bring Forward" Style="{StaticResource CleanButton}" Padding="6,3" Margin="0,0,2,0" ToolTip="Move one layer forward" Click="BtnBringForward_Click"/>
                                    <Button Content="↓ Send Backward" Style="{StaticResource CleanButton}" Padding="6,3" Margin="2,0,0,0" ToolTip="Move one layer backward" Click="BtnSendBackward_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- VIEW 2: PRINTING MODE & QUEUE -->
            <Grid x:Name="PrintQueueContainer" Visibility="Collapsed" Background="#F4F4F5">
                <Grid.ColumnDefinitions>
                    <!-- Left: Queue & Imposition Settings -->
                    <ColumnDefinition Width="420" MinWidth="360" MaxWidth="520"/>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Right: Live Sheet Preview & Execution -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT COLUMN -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#FFFFFF">
                    <StackPanel Margin="16,14">
                        <DockPanel LastChildFill="False" Margin="0,0,0,10">
                            <TextBlock Text="PRINT QUEUE" FontSize="12" FontWeight="Bold" Foreground="#09090B" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="➕ Add Current" Style="{StaticResource CleanPrimaryButton}" Padding="8,4" Margin="0,0,4,0" Click="BtnAddToQueue_Click"/>
                                <Button Content="Clear" Style="{StaticResource CleanButton}" Padding="8,4" Click="BtnClearQueue_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- DataGrid -->
                        <Border BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,14">
                            <DataGrid x:Name="DgPrintQueue" 
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column" 
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F4F4F5"
                                      Background="White" 
                                      RowHeight="32" 
                                      SelectionMode="Single"
                                      SelectionChanged="DgPrintQueue_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Card" Binding="{Binding CardName}" Width="*" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="Sides" Width="105">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox SelectedValue="{Binding SideOption, UpdateSourceTrigger=PropertyChanged}" 
                                                          Height="24" VerticalAlignment="Center"
                                                          SelectionChanged="QueueSideChanged">
                                                    <ComboBoxItem Content="Front &amp; Back"/>
                                                    <ComboBoxItem Content="Front Only"/>
                                                    <ComboBoxItem Content="Back Only"/>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                                    <DataGridTemplateColumn Header="" Width="36">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="✕" Width="20" Height="20" Foreground="#DC2626" Background="#FEE2E2" BorderThickness="0" Cursor="Hand" Click="BtnRemoveQueueItem_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Height="1" Background="#F4F4F5" Margin="0,0,0,12"/>

                        <!-- IMPOSITION SETTINGS -->
                        <TextBlock Text="IMPOSITION &amp; SHEET GRID" FontSize="11" FontWeight="Bold" Foreground="#09090B" Margin="0,0,0,8"/>

                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                            <TextBlock Text="Paper Size" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#3F3F46" Width="100"/>
                            <ComboBox x:Name="CmbPaperSize" SelectionChanged="CmbSheetSetting_Changed" Height="26">
                                <ComboBoxItem Content="Letter (8.5 × 11 inches)" IsSelected="True"/>
                                <ComboBoxItem Content="A4 (210 × 297 mm)"/>
                            </ComboBox>
                        </DockPanel>

                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                            <TextBlock Text="Paper Orient." VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#3F3F46" Width="100"/>
                            <ComboBox x:Name="CmbPaperOrientation" SelectionChanged="CmbSheetSetting_Changed" Height="26">
                                <ComboBoxItem Content="Portrait (Vertical Sheet)" IsSelected="True"/>
                                <ComboBoxItem Content="Landscape (Horizontal Sheet)"/>
                            </ComboBox>
                        </DockPanel>

                        <DockPanel LastChildFill="True" Margin="0,0,0,8">
                            <TextBlock Text="Grid Layout" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#3F3F46" Width="100"/>
                            <ComboBox x:Name="CmbGridLayout" SelectionChanged="CmbGridLayout_SelectionChanged" Height="26">
                                <ComboBoxItem Content="Standard 10-Up (2 Columns × 5 Rows)" IsSelected="True"/>
                                <ComboBoxItem Content="8-Up Grid (2 Columns × 4 Rows)"/>
                                <ComboBoxItem Content="Portrait 9-Up (3 Columns × 3 Rows)"/>
                                <ComboBoxItem Content="Portrait 12-Up (4 Columns × 3 Rows)"/>
                            </ComboBox>
                        </DockPanel>

                        <Button Content="🎯 Auto-Center Grid on Paper" Style="{StaticResource CleanButton}" Margin="0,0,0,10" Click="BtnAutoCenterGrid_Click"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DockPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="Left Margin: " VerticalAlignment="Center" FontSize="11" Foreground="#71717A"/>
                                <TextBox x:Name="TxtMarginLeft" Height="24" LostFocus="TxtMargin_LostFocus"/>
                            </DockPanel>
                            <DockPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="Top Margin: " VerticalAlignment="Center" FontSize="11" Foreground="#71717A"/>
                                <TextBox x:Name="TxtMarginTop" Height="24" LostFocus="TxtMargin_LostFocus"/>
                            </DockPanel>
                        </Grid>

                        <Border Height="1" Background="#F4F4F5" Margin="0,0,0,12"/>

                        <!-- DUPLEX METHOD -->
                        <TextBlock Text="DUPLEX METHOD (FRONT &amp; BACK)" FontSize="11" FontWeight="Bold" Foreground="#09090B" Margin="0,0,0,8"/>
                        <Border Background="#FAFAFA" BorderBrush="#E4E4E7" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <RadioButton x:Name="RbManualTwoPass" 
                                             Content="Manual 2-Pass Duplex (Recommended)" 
                                             IsChecked="True" 
                                             FontWeight="SemiBold" 
                                             FontSize="11.5"
                                             Foreground="#09090B" 
                                             Click="RbPrintMethod_Click" 
                                             Margin="0,0,0,3"/>
                                <TextBlock Text="Pass 1 prints Fronts, you flip paper stack, Pass 2 prints Backs with mirrored columns." 
                                           FontSize="10.5" Foreground="#71717A" Margin="18,0,0,6" TextWrapping="Wrap"/>

                                <RadioButton x:Name="RbAutoDuplex" 
                                             Content="Automatic Hardware Duplex" 
                                             FontWeight="SemiBold" 
                                             FontSize="11.5"
                                             Foreground="#09090B" 
                                             Click="RbPrintMethod_Click" 
                                             Margin="0,0,0,4"/>

                                <RadioButton x:Name="RbFrontsOnly" Content="Front Sides Only" FontSize="11.5" Foreground="#09090B" Click="RbPrintMethod_Click" Margin="0,0,0,2"/>
                                <RadioButton x:Name="RbBacksOnly" Content="Back Sides Only" FontSize="11.5" Foreground="#09090B" Click="RbPrintMethod_Click"/>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="ChkPrintCropMarks" Content="Print Corner Crop Marks (L-ticks)" IsChecked="True" Click="ChkPrintGuide_Click" FontSize="11" Margin="0,0,0,4"/>
                        <CheckBox x:Name="ChkPrintCutLines" Content="Print Cutting Grid Guidelines" IsChecked="True" Click="ChkPrintGuide_Click" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>

                <GridSplitter Grid.Column="1" Width="1" Background="#E4E4E7" HorizontalAlignment="Center"/>

                <!-- RIGHT COLUMN: PREVIEW & PRINT -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E4E4E7" BorderThickness="0,0,0,1" Padding="14,0">
                        <Grid VerticalAlignment="Center">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtQueueSummary" Text="Queue: 10 Cards | 1 Sheet" FontWeight="SemiBold" FontSize="12" Foreground="#09090B"/>
                                <TextBlock x:Name="TxtQueueDetails" Text="Manual 2-Pass Mode" Foreground="#71717A" FontSize="10.5"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="➖" Style="{StaticResource CleanButton}" Padding="7,2" Margin="0,0,3,0" ToolTip="Zoom Out Sheet (Ctrl+Wheel Down)" Click="BtnSheetZoomOut_Click"/>
                                <ComboBox x:Name="CmbSheetZoom" Width="88" Height="24" Padding="6,2" FontSize="11" SelectionChanged="CmbSheetZoom_SelectionChanged" Margin="0,0,3,0">
                                    <ComboBoxItem Content="Fit Page" IsSelected="True"/>
                                    <ComboBoxItem Content="50%"/>
                                    <ComboBoxItem Content="75%"/>
                                    <ComboBoxItem Content="100%"/>
                                    <ComboBoxItem Content="125%"/>
                                    <ComboBoxItem Content="150%"/>
                                    <ComboBoxItem Content="200%"/>
                                </ComboBox>
                                <Button Content="➕" Style="{StaticResource CleanButton}" Padding="7,2" Margin="0,0,10,0" ToolTip="Zoom In Sheet (Ctrl+Wheel Up)" Click="BtnSheetZoomIn_Click"/>
                                <Border Width="1" Background="#E4E4E7" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <Button Content="◀ Prev" Style="{StaticResource CleanButton}" Padding="8,2" Margin="0,0,4,0" Click="BtnPrevSheet_Click"/>
                                <Border Background="#F4F4F5" CornerRadius="4" Padding="8,3" Margin="0,0,4,0">
                                    <TextBlock x:Name="TxtSheetPageNumber" Text="Page 1 of 1" FontWeight="SemiBold" FontSize="11" Foreground="#18181B"/>
                                </Border>
                                <Button Content="Next ▶" Style="{StaticResource CleanButton}" Padding="8,2" Click="BtnNextSheet_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Sheet Image Canvas -->
                    <ScrollViewer x:Name="SheetScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F4F4F5"
                                  PreviewMouseWheel="SheetScrollViewer_PreviewMouseWheel" SizeChanged="SheetScrollViewer_SizeChanged">
                        <Grid Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="SheetPreviewBorder" Background="White" BorderBrush="#D4D4D8" BorderThickness="1" SnapsToDevicePixels="True"
                                    RenderOptions.BitmapScalingMode="HighQuality">
                                <Border.Effect>
                                    <DropShadowEffect Color="#090D1A" BlurRadius="20" ShadowDepth="4" Opacity="0.12"/>
                                </Border.Effect>
                                <Image x:Name="ImgSheetPreview" Stretch="None" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- Bottom Action Bar -->
                    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E4E4E7" BorderThickness="0,1,0,0" Padding="16,0">
                        <Grid VerticalAlignment="Center">
                            <TextBlock Text="💡 Columns are automatically mirrored for perfect front-to-back registration." Foreground="#71717A" FontSize="11" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🖼️ Export Sheets PNG" Style="{StaticResource CleanButton}" Padding="12,5" Margin="0,0,8,0" Click="BtnExportAllSheets_Click"/>
                                <Button Content="🖨️ PRINT CARDS" Style="{StaticResource CleanPrimaryButton}" Padding="16,5" FontSize="12" Click="BtnPrintCallingCards_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- SUBTLE STATUS BAR -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E4E4E7" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatusMessage" Text="Ready. Click any element to select and customize." FontSize="10.5" Foreground="#71717A" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatusCoords" Text="Orientation: Portrait | 2.0&quot; × 3.5&quot;" HorizontalAlignment="Right" FontSize="10.5" Foreground="#71717A" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
